{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "code-game",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "code-game",
      "database_id": ""
    }
  ],
  "observability": { "enabled": true }
}
